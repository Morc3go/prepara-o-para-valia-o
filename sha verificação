// 2) Macros de rotação e funções SHA-256
#define ROTR(x,n) (((x)>>(n))|((x)<<(32-(n))))
#define SHR(x,n)  ((x)>>(n))

#define CH(x,y,z)  (((x)&(y)) ^ (~(x)&(z)))
#define MAJ(x,y,z) (((x)&(y)) ^ ((x)&(z)) ^ ((y)&(z)))

#define SIG0(x) (ROTR(x,2)  ^ ROTR(x,13) ^ ROTR(x,22))
#define SIG1(x) (ROTR(x,6)  ^ ROTR(x,11) ^ ROTR(x,25))
#define sig0(x) (ROTR(x,7)  ^ ROTR(x,18) ^ SHR(x,3))
#define sig1(x) (ROTR(x,17) ^ ROTR(x,19) ^ SHR(x,10))

typedef struct {
    uint8_t  data[64];
    uint32_t datalen;
    uint64_t bitlen;
    uint32_t state[8];
} SHA256_CTX;

// Inicializa ctx->state com os valores iniciais
void sha256_init(SHA256_CTX *ctx) {
    ctx->datalen = 0;
    ctx->bitlen  = 0;
    ctx->state[0]=0x6a09e667ul; ctx->state[1]=0xbb67ae85ul;
    ctx->state[2]=0x3c6ef372ul; ctx->state[3]=0xa54ff53aul;
    ctx->state[4]=0x510e527ful; ctx->state[5]=0x9b05688cul;
    ctx->state[6]=0x1f83d9abul; ctx->state[7]=0x5be0cd19ul;
}

// Processa um bloco de 512 bits
void sha256_transform(SHA256_CTX *ctx, const uint8_t data[]) {
    uint32_t W[64], a,b,c,d,e,f,g,h, T1, T2;
    for(int t=0; t<16; ++t)
        W[t] = (data[4*t]<<24)|(data[4*t+1]<<16)|
               (data[4*t+2]<<8)|data[4*t+3];
    for(int t=16; t<64; ++t)
        W[t] = sig1(W[t-2]) + W[t-7] + sig0(W[t-15]) + W[t-16];
    a=ctx->state[0]; b=ctx->state[1]; c=ctx->state[2]; d=ctx->state[3];
    e=ctx->state[4]; f=ctx->state[5]; g=ctx->state[6]; h=ctx->state[7];
    for(int t=0; t<64; ++t) {
        T1 = h + SIG1(e) + CH(e,f,g) + K[t] + W[t];
        T2 = SIG0(a) + MAJ(a,b,c);
        h=g; g=f; f=e; e=d+T1;
        d=c; c=b; b=a; a=T1+T2;
    }
    ctx->state[0]+=a; ctx->state[1]+=b;
    ctx->state[2]+=c; ctx->state[3]+=d;
    ctx->state[4]+=e; ctx->state[5]+=f;
    ctx->state[6]+=g; ctx->state[7]+=h;
}

// Recebe dados arbitrários, faz chunking e chama transform
void sha256_update(SHA256_CTX *ctx, const uint8_t *data, size_t len) {
    for(size_t i=0; i<len; ++i) {
        ctx->data[ctx->datalen++] = data[i];
        if (ctx->datalen == 64) {
            sha256_transform(ctx, ctx->data);
            ctx->bitlen += 512;
            ctx->datalen = 0;
        }
    }
}

void sha256_final(SHA256_CTX *ctx, uint8_t hash[32]) {
    size_t i = ctx->datalen;
    ctx->data[i++] = 0x80;
    if (i > 56) {
        while (i<64) ctx->data[i++] = 0;
        sha256_transform(ctx, ctx->data);
        i = 0;
    }
    while (i < 56) ctx->data[i++] = 0;
    ctx->bitlen += ctx->datalen * 8;
    for(int j=0; j<8; ++j)
        ctx->data[63-j] = (ctx->bitlen >> (8*j)) & 0xFF;
    sha256_transform(ctx, ctx->data);
    for(i=0; i<4; ++i)
        for(int j=0; j<8; ++j)
            hash[i + j*4] = (ctx->state[j] >> (24 - i*8)) & 0xFF;
}

void print_hash(const uint8_t h[32]) {
    for(int i=0; i<32; i++) printf("%02x", h[i]);
    printf("\n");
}


int main() {
    uint8_t saved_hash[32] = {0}; 
    uint8_t cmp_hash[32];          
    SHA256_CTX ctx;
    char buffer[1024];
    int opcao;

    do {
        printf("\n=== MENU SHA-256 ===\n");
        printf("1) Inserir palavra e ver hash\n");
        printf("2) Verificar hash\n");
        printf("3) Encerrar\n");
        printf("Escolha uma opção: ");
        if (scanf("%d%*c", &opcao) != 1) {
            while (getchar()!='\n');
            opcao = 0;
        }

        switch (opcao) {
            case 1:
                printf("Digite a palavra: ");
                if (!fgets(buffer, sizeof(buffer), stdin)) break;
                buffer[strcspn(buffer, "\n")] = '\0';
                sha256_init(&ctx);
                sha256_update(&ctx, (uint8_t*)buffer, strlen(buffer));
                sha256_final(&ctx, saved_hash);
                printf("Hash salvo = ");
                print_hash(saved_hash);
                break;

            case 2:
                printf("Digite a palavra para verificar: ");
                if (!fgets(buffer, sizeof(buffer), stdin)) break;
                buffer[strcspn(buffer, "\n")] = '\0';
                sha256_init(&ctx);
                sha256_update(&ctx, (uint8_t*)buffer, strlen(buffer));
                sha256_final(&ctx, cmp_hash);
                printf("Hash calculado = ");
                print_hash(cmp_hash);
                if (memcmp(saved_hash, cmp_hash, 32) == 0)
                    printf(">>> o hash é valido\n");
                else
                    printf(">>> não é valido.\n");
                break;

            case 3:
                printf("Encerrando o programa.\n");
                break;

            default:
                printf("Opção inválida. Tente novamente.\n");
        }
    } while (opcao != 3);

    return 0;
}
