#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_INPUT 1024

// Variáveis globais
static char saved_b64[MAX_INPUT] = {0};    // Base64 salva
static char original_word[MAX_INPUT] = {0}; // Palavra original salva
static int has_saved_b64 = 0;              // Flag para indicar se já há Base64 salva

// Mapeamento dos caracteres Base64 para seus valores (0 a 63).
static int base64_val(char c) {
    if (c >= 'A' && c <= 'Z') return c - 'A';
    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
    if (c >= '0' && c <= '9') return c - '0' + 52;
    if (c == '+') return 62;
    if (c == '/') return 63;
    return -1; // '=' e caracteres inválidos
}

// Tabela para codificação Base64
static const char b64_table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

// Função de codificação Base64
void base64_encode(const char *input, char *output) {
    size_t len = strlen(input);
    size_t i = 0, j = 0;
    while (i < len) {
        unsigned char octet_a = input[i++];
        unsigned char octet_b = (i < len ? input[i++] : 0);
        unsigned char octet_c = (i < len ? input[i++] : 0);

        unsigned int triple = (octet_a << 16) | (octet_b << 8) | octet_c;

        output[j++] = b64_table[(triple >> 18) & 0x3F];
        output[j++] = b64_table[(triple >> 12) & 0x3F];
        output[j++] = (i - 1 > len) ? '=' : b64_table[(triple >> 6) & 0x3F];
        output[j++] = (i > len)     ? '=' : b64_table[triple & 0x3F];
    }
    output[j] = '\0';
}

// Função de decodificação Base64
void base64_decode(const char *input, char *output) {
    size_t len = strlen(input), i = 0, j = 0;
    while (i < len) {
        int v1 = base64_val(input[i]);
        int v2 = base64_val(input[i + 1]);
        int v3 = (input[i + 2] != '=') ? base64_val(input[i + 2]) : 0;
        int v4 = (input[i + 3] != '=') ? base64_val(input[i + 3]) : 0;

        unsigned int triple = (v1 << 18) | (v2 << 12) | (v3 << 6) | v4;

        output[j++] = (triple >> 16) & 0xFF;
        if (input[i + 2] != '=') output[j++] = (triple >> 8) & 0xFF;
        if (input[i + 3] != '=') output[j++] = triple & 0xFF;

        i += 4;
    }
    output[j] = '\0';
}

// Opção 1: salvar palavra original e Base64
void save_and_show_b64(void) {
    char palavra[MAX_INPUT];
    printf("\nDigite a palavra para converter em Base64 e salvar: ");
    if (!fgets(palavra, sizeof(palavra), stdin)) return;
    palavra[strcspn(palavra, "\n")] = '\0';

    // Salva a palavra original
    strncpy(original_word, palavra, MAX_INPUT);
    original_word[MAX_INPUT - 1] = '\0';

    // Gera e salva Base64
    base64_encode(palavra, saved_b64);
    has_saved_b64 = 1;

    printf("Base64 salva: %s\n", saved_b64);
}

// Opção 2: decodificar Base64 salva
void decode_saved_b64(void) {
    if (!has_saved_b64) {
        printf("\nNenhuma Base64 foi salva ainda. Use a opção 1 primeiro.\n");
        return;
    }
    char decoded[MAX_INPUT];
    base64_decode(saved_b64, decoded);
    printf("Decodificação da Base64 salva: %s\n", decoded);
}

// Opção 3: verificar palavra contra a original salva
void verify_saved_word(void) {
    if (!has_saved_b64) {
        printf("\nNenhuma Base64 foi salva ainda. Use a opção 1 primeiro.\n");
        return;
    }
    char tentativa[MAX_INPUT];
    printf("\nDigite a palavra para verificar contra a original salva: ");
    if (!fgets(tentativa, sizeof(tentativa), stdin)) return;
    tentativa[strcspn(tentativa, "\n")] = '\0';

    if (strcmp(tentativa, original_word) == 0) {
        printf("Verificação OK: as palavras coincidem.\n");
    } else {
        printf("Verificação falhou: as palavras sao diferentes.\n");
    }
}

int main(void) {
    int opcao;
    do {
        printf("\nMenu:\n");
        printf("1. Salvar e exibir Base64 de uma palavra\n");
        printf("2. Decodificar Base64 salva\n");
        printf("3. Verificar palavra contra a original salva\n");
        printf("0. Sair\n");
        printf("Escolha uma opção: ");

        if (scanf("%d", &opcao) != 1) {
            fprintf(stderr, "Entrada inválida. Encerrando.\n");
            break;
        }
        getchar(); // consome '\n' remanescente

        switch (opcao) {
            case 1: save_and_show_b64(); break;
            case 2: decode_saved_b64();  break;
            case 3: verify_saved_word(); break;
            case 0: puts("Encerrando programa."); break;
            default: puts("Opção inválida!");        break;
        }
    } while (opcao != 0);

    return 0;
}
